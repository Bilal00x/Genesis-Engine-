# Dockerfile for AI Game Studio Web Frontend

# Use official Node.js 18 runtime as a base image
FROM node:18-alpine AS builder

# Set environment variables
ENV NODE_ENV=production \
    APP_HOME=/app

# Set work directory
WORKDIR $APP_HOME

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy application code
COPY . .

# Build the application
RUN npm run build

# Use official nginx image as a production image
FROM nginx:alpine

# Copy the built application from the builder stage
COPY --from=builder $APP_HOME/.next/standalone /app
COPY --from=builder $APP_HOME/.next/static /app/.next/static
COPY --from=builder $APP_HOME/public /app/public
COPY --from=builder $APP_HOME/nginx.conf /etc/nginx/nginx.conf

# Expose port
EXPOSE 3000

# Start nginx
CMD ["nginx", "-g", "daemon off;"]